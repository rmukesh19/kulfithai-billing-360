rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'raachagan@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['userId', 'name', 'email', 'role', 'branchId', 'createdAt']) &&
               data.keys().size() == 6 &&
               data.userId == request.auth.uid &&
               data.role in ['admin', 'staff'] &&
               data.createdAt is timestamp;
      }

      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create: if isSignedIn() && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId && 
                    isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'branchId']) &&
                    incoming().createdAt == existing().createdAt;
    }

    match /test/connection {
      allow get: if true;
    }

    // --- Branches ---
    match /branches/{branchId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Permission check helper - verifies user belongs to branch or is global admin
      function userBelongsToBranch() {
        let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
        return isAdmin() || (exists(userPath) && get(userPath).data.branchId == branchId);
      }

      // --- Products ---
      match /products/{productId} {
        function isValidProduct(data) {
          return data.keys().hasAll(['name', 'sku', 'sellingPrice', 'stock', 'branchId']) &&
                 data.name is string && data.name.size() <= 200 &&
                 data.sku is string && data.sku.size() <= 50 &&
                 data.sellingPrice is number && data.sellingPrice >= 0 &&
                 data.stock is number &&
                 data.branchId == branchId;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidProduct(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && isValidProduct(incoming());
        allow delete: if isEmailVerified() && userBelongsToBranch();
      }

      // --- Invoices ---
      match /invoices/{invoiceId} {
        function isValidInvoice(data) {
          return data.keys().hasAll(['invoiceNumber', 'customerName', 'items', 'subtotal', 'totalTax', 'totalAmount', 'status', 'branchId', 'paymentMode', 'createdAt']) &&
                 data.invoiceNumber is string &&
                 data.items is list && data.items.size() > 0 &&
                 data.totalAmount is number &&
                 data.status in ['paid', 'pending', 'refunded'] &&
                 data.branchId == branchId &&
                 data.createdAt is timestamp;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidInvoice(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && 
                      isValidInvoice(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }

      // --- Customers ---
      match /customers/{customerId} {
        function isValidCustomer(data) {
          return data.keys().hasAll(['name', 'phone', 'branchId', 'balance']) &&
                 data.name is string && data.name.size() <= 100 &&
                 data.phone is string && data.phone.size() <= 15 &&
                 data.balance is number &&
                 data.branchId == branchId;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidCustomer(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && isValidCustomer(incoming());
      }

      // --- Suppliers ---
      match /suppliers/{supplierId} {
        function isValidSupplier(data) {
          return data.keys().hasAll(['name', 'phone', 'branchId', 'balance']) &&
                 data.name is string && data.name.size() <= 100 &&
                 data.phone is string && data.phone.size() <= 15 &&
                 data.balance is number &&
                 data.branchId == branchId &&
                 (!('category' in data) || data.category is string);
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidSupplier(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && isValidSupplier(incoming());
      }

      // --- Vouchers ---
      match /vouchers/{voucherId} {
        function isValidVoucher(data) {
          return data.keys().hasAll(['type', 'amount', 'description', 'branchId', 'date']) &&
                 data.type in ['receipt', 'payment', 'journal', 'contra'] &&
                 data.amount is number &&
                 data.branchId == branchId &&
                 data.date is timestamp &&
                 (!('ledgerId' in data) || data.ledgerId is string);
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidVoucher(incoming());
      }

      // --- Ledgers ---
      match /ledgers/{ledgerId} {
        function isValidLedger(data) {
          return data.keys().hasAll(['name', 'group', 'openingBalance', 'currentBalance', 'branchId']) &&
                 data.name is string && data.name.size() <= 200 &&
                 data.group in ['Asset', 'Liability', 'Income', 'Expense', 'Equity'] &&
                 data.openingBalance is number &&
                 data.currentBalance is number &&
                 data.branchId == branchId;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidLedger(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && isValidLedger(incoming());
        allow delete: if isEmailVerified() && userBelongsToBranch();
      }

      // --- Purchases ---
      match /purchases/{purchaseId} {
        function isValidPurchase(data) {
          return data.keys().hasAll(['purchaseNumber', 'supplierId', 'items', 'totalAmount', 'status', 'branchId', 'paymentMode', 'date']) &&
                 data.purchaseNumber is string &&
                 data.items is list && data.items.size() > 0 &&
                 data.totalAmount is number &&
                 data.status in ['paid', 'unpaid', 'partial'] &&
                 data.branchId == branchId &&
                 data.date is timestamp;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidPurchase(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && 
                      isValidPurchase(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }

      // --- Employees ---
      match /employees/{employeeId} {
        function isValidEmployee(data) {
          return data.keys().hasAll(['name', 'role', 'phone', 'branchId', 'salary', 'status', 'createdAt']) &&
                 data.name is string && data.name.size() <= 100 &&
                 data.role is string &&
                 data.phone is string &&
                 data.salary is number &&
                 data.status in ['present', 'absent'] &&
                 data.branchId == branchId &&
                 data.createdAt is timestamp;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidEmployee(incoming()) && incoming().createdAt == request.time;
        allow update: if isEmailVerified() && userBelongsToBranch() && isValidEmployee(incoming()) && 
                      incoming().createdAt == existing().createdAt;
      }

      // --- Categories ---
      match /categories/{categoryId} {
        function isValidCategory(data) {
          return data.keys().hasAll(['name', 'branchId']) &&
                 data.name is string && data.name.size() <= 100 &&
                 data.branchId == branchId;
        }

        allow list, get: if isSignedIn() && userBelongsToBranch();
        allow create: if isEmailVerified() && userBelongsToBranch() && isValidCategory(incoming());
        allow update: if isEmailVerified() && userBelongsToBranch() && isValidCategory(incoming());
        allow delete: if isEmailVerified() && userBelongsToBranch();
      }

      // --- Settings ---
      match /settings/config {
        function isValidConfig(data) {
          return data.keys().hasAll(['companyName', 'invoicePrefix']) &&
                 data.companyName is string && data.companyName.size() <= 200 &&
                 data.invoicePrefix is string && data.invoicePrefix.size() <= 10;
        }

        allow get: if isSignedIn() && userBelongsToBranch();
        allow write: if isEmailVerified() && userBelongsToBranch() && isValidConfig(incoming());
      }
    }
  }
}
